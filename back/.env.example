PORT=3001

# Supabase Postgres connection string. Copy this file to .env and add the
# connection string only on your computer or in the deployment dashboard.
DATABASE_URL=

# Telegram bot token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=
# Random URL-safe value with at least 32 characters. Telegram sends it back
# in X-Telegram-Bot-Api-Secret-Token for every webhook update.
TELEGRAM_WEBHOOK_SECRET=
# Telegram Mini App auth payload lifetime in seconds.
TELEGRAM_INIT_MAX_AGE_SEC=3600

# Public URLs are safe to store here; use the deployed URLs in production.
APP_URL=http://localhost:5173
# Comma-separated extra frontend origins, without paths.
CORS_ALLOWED_ORIGINS=
# BACKEND_URL=http://localhost:3001

# TLS mode for remote PostgreSQL. "require" encrypts traffic and works with
# Supabase pooler certificates; "verify-full" also verifies the server.
DATABASE_SSL_MODE=require
# For strict verification, paste the PEM certificate downloaded from
# Supabase Database Settings and set DATABASE_SSL_MODE=verify-full.
# DATABASE_SSL_CA=

# Telegram ID of the first administrator.
SEED_ADMIN_TG_ID=
