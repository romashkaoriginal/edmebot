PORT=3001

# Supabase Postgres connection string. Copy this file to .env and add the
# connection string only on your computer or in the deployment dashboard.
DATABASE_URL=

# Telegram bot token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=
# Random URL-safe value with at least 32 characters. Telegram sends it back
# in X-Telegram-Bot-Api-Secret-Token for every webhook update.
TELEGRAM_WEBHOOK_SECRET=
# Telegram Mini App auth payload lifetime in seconds. Telegram mints initData
# once per app open, so this must cover the longest realistic session:
# too short and a slow student gets 401 mid-diagnostic with no recovery.
TELEGRAM_INIT_MAX_AGE_SEC=86400

# Keep the service awake by pinging its own /api/health every 10 minutes.
# On by default when RENDER_EXTERNAL_URL is present; set "off" on a paid
# instance that never sleeps.
KEEP_ALIVE=

# Public URLs are safe to store here; use the deployed URLs in production.
APP_URL=http://localhost:5173
# Comma-separated extra frontend origins, without paths.
CORS_ALLOWED_ORIGINS=
# BACKEND_URL=http://localhost:3001

# TLS mode for remote PostgreSQL. "require" encrypts traffic and works with
# Supabase pooler certificates; "verify-full" also verifies the server.
DATABASE_SSL_MODE=require
# For strict verification, paste the PEM certificate downloaded from
# Supabase Database Settings and set DATABASE_SSL_MODE=verify-full.
# DATABASE_SSL_CA=

# Telegram ID of the first administrator.
SEED_ADMIN_TG_ID=

# CRM «Мой Класс». The key may also live in the project-root .env for local
# runs; inject it into the backend environment in production.
MOYKLASS_API_KEY=
# 32+ random URL-safe characters. Add the webhook URL to the CRM scenario
# "Информация об ученике изменилась" (user_changed).
MOYKLASS_WEBHOOK_SECRET=
# JSON map from CRM "Бот — Предметы" variant IDs to app subjects, e.g.
# MOYKLASS_SUBJECT_MAP={"123":"Математика","124":"Физика"}
MOYKLASS_SUBJECT_MAP={}
# Set true only after existing students have been linked and verified.
MOYKLASS_ENFORCE_LINKS=false
